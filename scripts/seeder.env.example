# Use the OpenAI-compatible deployment endpoint for the Foundry-hosted embedding deployment.
# Typical shape: https://<custom-subdomain>.openai.azure.com/openai/v1/
AZURE_COSMOSDB_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
AZURE_COSMOSDB_DATABASE_NAME=care-guidance
AZURE_COSMOSDB_CONTAINER_NAME=guidance
AZURE_OPENAI_BASE_URL=https://<foundry-openai-endpoint>.openai.azure.com/openai/v1/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
SEED_DOCUMENT_COUNT=1024
EMBEDDING_DIMENSIONS=1536
